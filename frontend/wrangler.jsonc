// Cloudflare Workers + Static Assets config.
//
// This file tells Cloudflare:
//   1. Where the built static assets live (./frontend/dist after `npm run build`)
//   2. To use SPA fallback (any unknown path → index.html, so React Router works)
//
// The actual build command (`npm run build`) is configured in the Cloudflare
// dashboard under: Workers & Pages → fin-intel → Settings → Builds.
//
// Required dashboard settings:
//   • Root directory:           frontend
//   • Build command:            npm run build
//   • Build output directory:   dist
//   • Deploy command:           npx wrangler deploy
{
  "$schema":             "node_modules/wrangler/config-schema.json",
  "name":                "fin-intel",
  "compatibility_date":  "2024-11-01",
  "assets": {
    "directory":           "./dist",
    "not_found_handling":  "single-page-application"
  }
}
